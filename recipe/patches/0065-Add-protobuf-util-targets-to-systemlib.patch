From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Fri, 16 May 2026 00:00:00 -0400
Subject: [PATCH] Add protobuf util targets to systemlib protobuf.BUILD

Declare the protobuf utility targets (field_mask_util, differencer,
json_util, delimited_message_util, type_resolver) and well_known_protos
that TF 2.21.0/XLA reference but the systemlib protobuf.BUILD lacked,
aliasing the cc_libraries to :protobuf since the code ships in libprotobuf.
---
diff --git a/third_party/systemlibs/protobuf.BUILD b/third_party/systemlibs/protobuf.BUILD
index cf85b5ab..7d2377e6 100644
--- a/third_party/systemlibs/protobuf.BUILD
+++ b/third_party/systemlibs/protobuf.BUILD
@@ -141,3 +141,23 @@ py_proto_library(
     srcs = [proto[1][0] for proto in WELL_KNOWN_PROTO_MAP.items()],
     visibility = ["//visibility:public"],
 )
+
+# protobuf C++ utility libraries -- the code ships inside the system
+# libprotobuf, so alias each to the :protobuf cc_library.
+[alias(
+    name = n,
+    actual = ":protobuf",
+    visibility = ["//visibility:public"],
+) for n in [
+    "field_mask_util",
+    "differencer",
+    "json_util",
+    "delimited_message_util",
+    "type_resolver",
+]]
+
+filegroup(
+    name = "well_known_protos",
+    srcs = [":link_proto_files"],
+    visibility = ["//visibility:public"],
+)
