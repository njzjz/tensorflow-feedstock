From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Sat, 27 Jan 2024 22:27:56 -0500
Subject: [PATCH] Adjust relative path for libdevice

---
 third_party/xla/xla/tsl/platform/default/cuda_root_path.cc | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/third_party/xla/xla/tsl/platform/default/cuda_root_path.cc b/third_party/xla/xla/tsl/platform/default/cuda_root_path.cc
index 8ac4bc05..81a373cc 100644
--- a/third_party/xla/xla/tsl/platform/default/cuda_root_path.cc
+++ b/third_party/xla/xla/tsl/platform/default/cuda_root_path.cc
@@ -91,9 +91,11 @@ std::vector<std::string> CandidateCudaRoots() {
     // Runtime check on the version string content
     std::vector<const char*> paths_to_add =
         absl::StartsWith(TF_CUDA_VERSION, "13")
-            ? std::vector<const char*>{"../nvidia/cu13", "../../nvidia/cu13"}
+            ? std::vector<const char*>{"../nvidia/cu13", "../../nvidia/cu13",
+                                       "../../../.."}
             : std::vector<const char*>{"../nvidia/cuda_nvcc",
-                                       "../../nvidia/cuda_nvcc"};
+                                       "../../nvidia/cuda_nvcc",
+                                       "../../../.."};
 
     for (const char* path : paths_to_add) {
       roots.emplace_back(io::JoinPath(dir, path));
